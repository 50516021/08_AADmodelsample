    (project_out): Conv2d(64, 64, kernel_size=(1, 1), stride=(1, 1), bias=False)
    (Multiscale_Temporal_Attention): Multiscale_Temporal_Attention(
      (spatioConv): Conv2d(1, 1, kernel_size=(64, 1), stride=(1, 1))
      (upChannelConv): Conv1d(1, 3, kernel_size=(1,), stride=(1,))
      (project_out): Conv2d(1, 64, kernel_size=(1, 1), stride=(1, 1))
      (multiTemporal_K_2): Multiscale_Temporal_Layer(
        (multiscaleConv): Conv1d(1, 1, kernel_size=(2,), stride=(1,), padding=same)
        (act): ELU(alpha=1.0)
        (norm): LayerNorm((128,), eps=1e-05, elementwise_affine=True)
        (pool): AdaptiveAvgPool1d(output_size=1)
      )
      (multiTemporal_K_4): Multiscale_Temporal_Layer(
        (multiscaleConv): Conv1d(1, 1, kernel_size=(4,), stride=(1,), padding=same)
        (act): ELU(alpha=1.0)
        (norm): LayerNorm((128,), eps=1e-05, elementwise_affine=True)
        (pool): AdaptiveAvgPool1d(output_size=1)
      )
      (multiTemporal_K_6): Multiscale_Temporal_Layer(
        (multiscaleConv): Conv1d(1, 1, kernel_size=(6,), stride=(1,), padding=same)
        (act): ELU(alpha=1.0)
        (norm): LayerNorm((128,), eps=1e-05, elementwise_affine=True)
        (pool): AdaptiveAvgPool1d(output_size=1)
      )
    )
  )
  (flatten): Flatten(start_dim=1, end_dim=-1)
  (Spatiotemporal_Convolution): Spatiotemporal_Convolution(
    (Temporal_Convolution): Sequential(
      (0): Conv2d(1, 5, kernel_size=(1, 2), stride=(1, 1))
      (1): BatchNorm2d(5, eps=1e-05, momentum=0.1, affine=True, track_running_stats=True)
      (2): ELU(alpha=1.0)
    )
    (Spatio_Convolution): Sequential(
      (0): Conv2d(5, 5, kernel_size=(64, 1), stride=(1, 1))
