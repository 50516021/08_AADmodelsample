    (conv_0): Conv2d(1, 1, kernel_size=(3, 3), stride=(1, 1), padding=same)
    (conv_1): Conv2d(1, 1, kernel_size=(5, 5), stride=(1, 1), padding=same, dilation=(2, 2))
    (conv_2): Conv2d(1, 1, kernel_size=(7, 7), stride=(1, 1), padding=same, dilation=(3, 3))
    (upChannel): Sequential(
      (0): Conv2d(1, 3, kernel_size=(1, 1), stride=(1, 1))
    )
  )
  (gap): Sequential(
    (0): AdaptiveAvgPool2d(output_size=1)
    (1): Flatten(start_dim=1, end_dim=-1)
  )
