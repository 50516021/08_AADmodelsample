#!/bin/bash -l

# This is were we go for slurm documentation https://slurm.schedmd.com/sbatch.html
# 20261104 run one subject per SLURM array task (subject = SLURM_ARRAY_TASK_ID)

#SBATCH --job-name=DARNet_DTU_20261104_ws1              # Name of the job
#SBATCH --comment="DARNet DTU training"           # Comment for your job
#SBATCH --account=spatt


# %x is job name, %A is array job ID, and %a is array task ID (= subject number)
#SBATCH --output=./log/%x_%A/%x_%A_sub%a.out                # Output file
#SBATCH --error=./log/%x_%A/%x_%A_sub%a.err                 # Error file

#SBATCH --mail-user=slack:@at2163                # Slack username to notify
#SBATCH --mail-type=END                         # Type of slack notifications to send

#SBATCH --time=1-00:00:00                        # Time limit day-hour:minutes:seconds
#SBATCH --nodes=1                               # How many nodes to run on
#SBATCH --partition=debug                      # Partitions {debug,sporc,tigris} 
#SBATCH --mem=64G                                # Job memory
#SBATCH --ntasks=1                              # How many tasks per node
#SBATCH --cpus-per-task=18                      # Number of CPUs per task
#SBATCH --gres=gpu:a100:1                            # Number of GPUs per task
#SBATCH --array=1-18%4                          # Subjects 1-16 (KUL; use 1-18 for DTU), at most 4 tasks concurrently
##SBATCH --mem-per-cpu=32G                      # Memory per CPU (this line is here as an example but commented out)

set -euo pipefail

# Save this script with the array-task logs.
cp "$0" "./log/${SLURM_JOB_NAME}_${SLURM_ARRAY_JOB_ID}/slurm_script"

echo "========== Job Information =========="
echo "Hostname : $(hostname)"
echo "Date     : $(date)"
echo "Subject  : S${SLURM_ARRAY_TASK_ID}"
echo "GPU(s):"
nvidia-smi

echo "========== Python Environment =========="
python --version
uv --version

# # (Optional) Load modules if required by SPORC
# module load cuda/12.4
# module load gcc/...

# Change to the project directory
cd "../"

# Ensure the log / checkpoint directories exist
mkdir -p log pre_trained_models

# KUL needs data_conv_akira/KUL_npz (run data_conv_akira/convert_KUL.py once beforehand)
DATASET=DTU       # KUL or DTU
TIME_LEN=1        # decision window [s]

echo "========== Running =========="

# Run one subject: --subject selects only this task's subject.
uv run python main_akira.py --dataset "$DATASET" --time_len "$TIME_LEN" --subject "$SLURM_ARRAY_TASK_ID" #--seed 1234 --max_epoch 100

echo "========== Finished =========="
